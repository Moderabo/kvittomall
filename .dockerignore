# Mirrors .gitignore, plus dev/VCS/build-only files that don't belong in the image -
# nothing here should ever be baked into a build, mirroring why git doesn't track it.

.git/
.github/
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage

# Runtime state the pipeline owns and rebuilds itself - see paths.py/paths.ensure_dirs().
# config/ specifically holds web-UI-edited preferences (PDF layout, column mapping),
# not pipeline output, but it's the same idea: a user's local state, not build input.
data/
final/
logs/
config/

# Secrets and machine-specific config - supplied at `docker run`/compose time instead,
# see docker-compose.yml. *.json is also what's actually inside config/ above (a user
# preference, not build-time input) for the same reason .gitignore excludes them.
.env
*.json

# Dev-only, not needed at runtime.
tests/
requirements-dev.txt

# Docker/VCS/editor metadata - never useful inside the image itself.
Dockerfile
docker-compose.yml
.dockerignore
.gitignore
