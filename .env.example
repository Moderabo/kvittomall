# Copy this file to .env and fill in the values you need. Every line below is shown
# with its default - lines you leave commented out just mean "use the default from
# config.py"; nothing here is required except SHEET_ID and SHEET_GID.

# --- Required: which Google Sheet to read ---
# The spreadsheet ID is the long id in the sheet's URL
# (https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit#gid=<SHEET_GID>).
SHEET_ID="din_sheet_id_här"
SHEET_GID="din_sheet_gid_här"

# --- How to reach the Sheet and Drive: public | api | auto (default: auto) ---
# See README.md's "Åtkomst till kalkylbladet och Drive" section for the full
# explanation of the tradeoffs between these.
# ACCESS_MODE="auto"

# Required if ACCESS_MODE is "api" or "auto" (the default). Path to the service
# account's downloaded JSON key file - see README.md for where to find/create one.
# GOOGLE_SERVICE_ACCOUNT_FILE="/sökväg/till/service-account-nyckel.json"

# --- Sheet column names, if your Google Form's questions are worded differently
# than the defaults below (see kvittomall/config.py for how these are used) ---
# SHEET_COLUMN_TIMESTAMP="Tidstämpel"
# SHEET_COLUMN_NAME="Namn"
# SHEET_COLUMN_RECEIPT_LINKS="Ladda upp bild"
# SHEET_COLUMN_TRANSACTION_TYPE="Transaktionstyp"
# SHEET_COLUMN_SUM="Summa"
# SHEET_COLUMN_DATE="Datum för händelsen"
# SHEET_COLUMN_MIL="Körda mil"
# SHEET_COLUMN_ROUTE="Sträcka"
# SHEET_COLUMN_ACCOUNT="Kontonummer"
# SHEET_COLUMN_COMMITTEE="Utskott"
# SHEET_COLUMN_EVENT="Arrangemang"
# SHEET_COLUMN_SPECIFICATION="Specificering"
# SHEET_COLUMN_OTHER="Övrigt"

# --- Receipt image compression: extreme | high | normal (default) | low | potato ---
# See README.md's Konfiguration section for what each tier means.
# IMAGE_QUALITY="normal"
