# Environment variables
.env

# Python cache and virtual environments
__pycache__/
*.pyc
venv/
*.venv/
.pytest_cache/

# Log files
logs/

# Working data - downloads/, processed/, responses.csv, kvittomall_state.db(-*), lock file
data/

# Final deliverable output
final/

# API keys - *.json is broad, but this project has no legitimate tracked JSON files,
# and Google's default downloaded key filename (<project-id>-<hash>.json) won't always
# start with "kvittomall-", so a narrower pattern risks missing a rotated/second key.
*.json